# =============================================================
# matreko-reverse-proxy 全局配置
# 复制为 .env 后修改：cp .env.example .env   （或运行 ./rpctl init）
# .env 含密钥，已被 .gitignore 忽略，切勿提交
# =============================================================

# ---------- 证书 / TLS ----------
# cloudflare : 通过 Cloudflare DNS-01 向 Let's Encrypt/ZeroSSL 申请正式证书（生产）
# internal   : Caddy 自签本地 CA 证书，无需域名和 Token（开发机本地调试）
CADDY_TLS_MODE=cloudflare

# ACME 账户邮箱（证书到期提醒等）
ACME_EMAIL=admin@example.com

# ---------- Cloudflare ----------
# API Token：需要 Zone.Zone:Read + Zone.DNS:Edit 权限，作用域限定到你的域名；
# 有站点走 Tunnel 时还需要 Account.Cloudflare Tunnel:Edit。创建方法见 docs/cloudflare.md
CF_API_TOKEN=

# 托管在 Cloudflare 上的根域名（rpctl dns sync 用它查询 Zone ID）
CF_ZONE=example.com

# 每个站点的接入方式由站点文件决定（见 proxy/Caddyfile 开头的说明）：
#   公网 443（默认）：DNS 为指向下方 SERVER_IPV4/6 的 A/AAAA 记录
#   Tunnel：DNS 为指向 Tunnel 的 CNAME，服务器 IP 不出现在该域名的解析中（Web SSH、防火墙地图）

# [公网 443] 同步 DNS 记录时是否开启 Cloudflare 代理（橙色云朵）
CF_PROXIED=true
# [公网 443] 服务器公网地址（留空则跳过对应记录类型）
SERVER_IPV4=
SERVER_IPV6=

# [Tunnel] 运行 Token：由 ./rpctl tunnel create 自动写入（也可在控制台创建 Tunnel 后粘贴）
# 设置后 rpctl up 会启动 cloudflared
CF_TUNNEL_TOKEN=

# ---------- Caddy 监听端口 ----------
# 公网监听地址；暂时没有走公网 443 的站点时，可设为 127.0.0.1，并在安全组关闭 80/443
# LISTEN_ADDR=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# Tunnel 站点在本机回环上的调试端口（https://<域名>:8443，开发机用它访问 Web SSH）
# TUNNEL_LOCAL_PORT=8443

# ---------- 各服务域名 ----------
# 约定：所有以 _DOMAIN 结尾的变量都会被 rpctl dns sync 同步到 Cloudflare
# 开发机可用 *.localhost（浏览器会自动解析到 127.0.0.1），配合 CADDY_TLS_MODE=internal
WEBSSH_DOMAIN=ssh.example.com
# 防火墙地图（services/fwmap），开发机可用 fw.localhost
FWMAP_DOMAIN=fw.example.com

# ---------- 防火墙地图（services/fwmap，见其 README.md） ----------
# DigitalOcean 只读 Token：Custom Scopes 只勾选 droplet / firewall / vpc 的 read
FWMAP_DO_TOKEN=
# Cloudflare Access：团队域名（<团队名>.cloudflareaccess.com）和 Access 应用的 AUD Tag
# 生产模式下两项都必须设置，否则页面拒绝所有访问
FWMAP_ACCESS_TEAM=
FWMAP_ACCESS_AUD=
# （可选）给网段、端口起名，逗号分隔
# FWMAP_LABELS="198.51.100.24/32=办公室,203.0.113.0/24=家里"
# FWMAP_PORTS="7650=Blog,9443=Portainer"
